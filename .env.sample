ENVIRONMENT=development
DATABASE_URL=postgresql://bridge_app:password@localhost/appgen
# Internal Swagger route index is opt-in and forbidden in production.
SWAGGER_ENABLED=false
# Required in production and hardened environments so startup migrations run
# with the admin role instead of the least-privilege runtime role.
ADMIN_DATABASE_URL=postgresql://bridge_admin:password@localhost/appgen

# Clerk Frontend API URL (JWT issuer). Default: dev instance
# CLERK_FRONTEND_API=https://your-clerk-instance.clerk.accounts.dev
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# Admin UI auth uses Clerk session JWT verification plus org membership enforcement.
# If ADMIN_CLERK_FRONTEND_API is omitted, Bridge falls back to CLERK_FRONTEND_API,
# then derives the issuer from CLERK_PUBLISHABLE_KEY.
# ADMIN_CLERK_ORG_ID is optional — if omitted, any valid JWT from the configured
# Clerk instance is accepted (no org membership check). Set it in production to
# restrict access to your internal admin org (requires Clerk organizations/paid plan).
# ADMIN_CLERK_ORG_ID=org_your_internal_admin_org
# ADMIN_CLERK_FRONTEND_API=https://your-internal-clerk-instance.clerk.accounts.dev
# Browser-origin allowlist. Required in production; production values must use
# public HTTPS origins.
# ADMIN_CLERK_AUTHORIZED_PARTIES=https://admin.example.com
# Admin API per-actor rate limits per minute. Defaults: reads=120, mutations=10.
# ADMIN_READ_RATE_LIMIT_PER_MINUTE=120
# ADMIN_MUTATION_RATE_LIMIT_PER_MINUTE=10
# Admin pre-auth IP throttle for failed/missing Clerk JWTs. Default: 10 failures per 60 seconds per IP.
# ADMIN_AUTH_IP_LIMIT=10

# Background Jobs Toggle
# Enable/disable scheduled background tasks (price step-up processing, cleanup, reconciliation)
# Default: true
ENABLE_BACKGROUND_JOBS=true

# Support emails for reconciliation alerts and admin notifications
# Email address that receives alerts when subscriptions are automatically revoked
# Or the email from used by Resend provider
APP_EMAIL_SUPPORT=support@bridge.local
APP_EMAIL_FROM=noreply@bridge.local

# Email Provider Configuration
# Supported providers: mock (logs to console), clerk, resend
EMAIL_PROVIDER=mock
# For Clerk provider - value 'clerk'
# CLERK_SECRET_KEY=your-clerk-secret-key (already above, reused)
# For Resend provider - value 'resend'
# RESEND_API_KEY=your-resend-api-key

######

# Disable Rate Limiting (testing/development only)
# When enabled, bypasses all rate limit checks for development and testing
RATE_LIMIT_DISABLE=false

# Comma-separated IP literals of trusted reverse proxies allowed to set
# X-Forwarded-For / X-Real-IP for per-IP rate limiting. When unset, forwarded
# headers are ignored and the TCP socket peer IP is used directly.
# Only IP literals are supported (CIDR ranges like 10.0.0.0/8 are rejected).
# TRUSTED_PROXIES=127.0.0.1

# Bypass Clerk Admin Authentication (testing/development only - NEVER IN PRODUCTION)
# When enabled, bypasses Clerk JWT verification for admin endpoints and mocks the session.
BYPASS_ADMIN_AUTH=false

# Rate limit cleanup job
# Delete old rate limit entries older than this many hours
# Default: 72 hours
RATE_LIMIT_CLEANUP_HOURS=72

######

# Mock External APIs for local testing (dev/testing only - NEVER USE IN PRODUCTION)
# When enabled, verify_token() returns stubbed responses instead of calling real Google API
# Allows CLI tests to run without valid purchase tokens (which expire after 10 minutes)
MOCK_EXTERNAL_APIS=false

# Google Play service account bootstrap (production/staging only)
# GOOGLE_PLAY_KEY contains the full service account JSON; Bridge writes it to GOOGLE_SERVICE_ACCOUNT_PATH.
# Provider configs still reference the resulting file path via config.service_account_json.
# GOOGLE_PLAY_KEY={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_PATH=/run/secrets/google-play-service-account.json

# Verify JWT signature from Google Pub/Sub (recommended for production)
GOOGLE_VERIFY_WEBHOOK_SIGNATURE=true

# Verify JWT audience claim (disable for dev with ngrok tunnels)
GOOGLE_VERIFY_AUDIENCE=false

# Expected Pub/Sub webhook URL (required when GOOGLE_VERIFY_AUDIENCE=true)
GOOGLE_PUB_SUB_AUDIENCE=https://api.yourdomain.com/webhooks/google

# Verify Pub/Sub push service account identity (email + email_verified claim check)
# Production/non-mock forces this on even if set false; false is honored only for local mock tests.
GOOGLE_VERIFY_PUBSUB_IDENTITY=true

# Expected Pub/Sub push service account email (required when Google webhook signature verification is enabled in non-mock)
GOOGLE_PUB_SUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@your-project.iam.gserviceaccount.com

# Skip RSA signature verification (dev/testing only - INSECURE)
GOOGLE_SKIP_RSA_VERIFICATION=false

# Emergency cleanup bypass on production environments (break-glass switch)
ALLOW_EMERGENCY_CLEANUP=false
